# Supabase project (commuter-connect, us-east-1).
# The publishable key is safe to commit — all access is governed by RLS and
# SECURITY DEFINER functions server-side. EXPO_PUBLIC_* vars are inlined at
# bundle time by Expo CLI and picked up by EAS Build from this file.
EXPO_PUBLIC_SUPABASE_URL=https://voqberiubbodifcctahi.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_koATLcOAAedaFHl2AkpL3g_Xom-W02j

# AWS Rekognition Face Liveness (both values are public identifiers; the
# identity pool only grants guest StartFaceLivenessSession — results are
# fetched and scored server-side by the liveness Edge Function).
EXPO_PUBLIC_AWS_REGION=us-east-1
EXPO_PUBLIC_AWS_IDENTITY_POOL_ID=us-east-1:9e415bb9-77a5-4131-b856-dafedb134f6e
